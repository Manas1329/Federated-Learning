# Set USE_QUANTIZATION=1 to enable INT8 quantization (4x compression)
USE_QUANTIZATION=1

# Set FORCE_CPU=1 for stable multi-client CPU execution on Windows laptops
FORCE_CPU=1

# Set USE_DP=0 for fast standard FedAvg, or USE_DP=1 for Differential Privacy
USE_DP=0

DP_NOISE_MULTIPLIER=0.3
DP_MAX_GRAD_NORM=1.0
DP_DELTA=0.00001