# Set USE_QUANTIZATION=1 to enable quantization, or USE_QUANTIZATION=0 to disable it
USE_QUANTIZATION=1

# Set FORCE_CPU=1 to force CPU training, or FORCE_CPU=0 to automatically use GPU if available
# IMPORTANT for local multi-client simulation:
# If Hospital_A, Hospital_B, and Hospital_C all run on the same machine with a single GPU,
# set FORCE_CPU=1 to avoid GPU memory contention. ChestCNN is small enough to train on CPU.
FORCE_CPU=0

USE_DP=0

DP_NOISE_MULTIPLIER=1.0

DP_MAX_GRAD_NORM=1.0

DP_DELTA=0.00001

# VERBOSE_LOGGING=0 for compact logs (recommended), VERBOSE_LOGGING=1 for detailed debugging
VERBOSE_LOGGING=0

# ---- Multi-Device Network Configuration ----
# PRIMARY DEPLOYMENT: 4 physical devices (1 server + 3 hospital clients).
#
# On the SERVER DEVICE:
#   FL_PORT=8080              (port to bind on)
#   FL_SERVER_BIND=0.0.0.0   (bind to all interfaces so remote clients can reach it)
#   python federated_healthcare/src/server.py
#
# On each HOSPITAL CLIENT DEVICE:
#   SERVER_ADDRESS=<SERVER_LAN_IP>:8080
#   CLIENT_NAME=Hospital_A   (or Hospital_B, Hospital_C)
#   DATA_PATH=/path/to/local/hospital_data
#   python federated_healthcare/src/client.py
#
# Do NOT set SERVER_ADDRESS to localhost on hospital devices —
# they need the actual LAN IP of the server machine.
#
# Flower gRPC handles concurrent client connections natively.
# No threading setup is required in your code for this.

# Server: address that clients use to reach the Flower server.
# On the server device, this is not used. On hospital client devices,
# set this to <server-LAN-IP>:<port>, e.g. 192.168.1.10:8080
SERVER_ADDRESS=localhost:8080

# Server: port to bind on (server device only). Default: 8080
FL_PORT=8080

# Server: network interface to bind on. Default: 0.0.0.0 (all interfaces).
# Change only if you need to restrict to a specific network adapter.
FL_SERVER_BIND=0.0.0.0

# ---- Concurrency / Performance ----
# Hospital clients are launched as independent processes (not threads).
# This avoids Python GIL limitations for CPU-heavy PyTorch training.
# The Flower server acts as the rendezvous: all clients train independently
# and submit updates when done. The server aggregates once quorum is reached.
#
# To run all three hospitals concurrently on one machine (local dev only):
#   python run_local.py
#
# For real 4-device deployment, see DEMO_INSTRUCTIONS.md

