# Set USE_QUANTIZATION=1 to enable quantization, or USE_QUANTIZATION=0 to disable it
USE_QUANTIZATION=1

# Set FORCE_CPU=1 to force CPU training, or FORCE_CPU=0 to automatically use GPU if available
# IMPORTANT for local multi-client simulation:
# If Hospital_A, Hospital_B, and Hospital_C all run on the same machine with a single GPU,
# set FORCE_CPU=1 to avoid GPU memory contention. ChestCNN is small enough to train on CPU.
FORCE_CPU=1

USE_DP=0

DP_NOISE_MULTIPLIER=1.0

DP_MAX_GRAD_NORM=1.0

DP_DELTA=0.00001

VERBOSE_LOGGING=0

# ---- Concurrency / Performance ----
# Hospital clients are launched as independent processes (not threads).
# This avoids Python GIL limitations for CPU-heavy PyTorch training.
# The Flower server acts as the rendezvous: all clients train independently
# and submit updates when done. The server aggregates once quorum is reached.
#
# To run all three hospitals concurrently on one machine:
#   python run_local.py
#
# To benchmark sequential vs concurrent wall-clock time, compare the
# client_wall_clock_time_sec column in the per-client CSV metric files.