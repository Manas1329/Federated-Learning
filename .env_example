# ==============================================================================
# FEDERATED HEALTHCARE - PERIODIC RETRAINING CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Training Mode & Model Warm-Start
# ------------------------------------------------------------------------------
# TRAINING_MODE: 'warm_start' (default for periodic retraining) or 'fresh'
TRAINING_MODE=warm_start

# INIT_MODEL_PATH: Path to initial approved global checkpoint for warm-start.
# If empty, automatically checks ./federated_healthcare/models/approved/global_model.pth
INIT_MODEL_PATH=./federated_healthcare/models/approved/global_model.pth

# ALLOW_RANDOM_FALLBACK: If 0, stops run immediately if warm-start checkpoint is missing/invalid.
# Never silently initialises random weights when warm_start is requested.
ALLOW_RANDOM_FALLBACK=0

# ------------------------------------------------------------------------------
# 2. Dataset Versioning & Manifests (Preserves Existing Dataset Directory Structure)
# ------------------------------------------------------------------------------
# Logical dataset version to load via manifest (e.g., dataset_v001, dataset_v002)
DATASET_VERSION=dataset_v001

# Split ratios and seed for manifest generation
TRAIN_RATIO=0.70
VALIDATION_RATIO=0.15
TEST_RATIO=0.15
SPLIT_SEED=42

# ------------------------------------------------------------------------------
# 3. Federated Rounds & Early Stopping
# ------------------------------------------------------------------------------
NUM_ROUNDS=10
MIN_ROUNDS=5
LOCAL_EPOCHS=2
BATCH_SIZE=32
LEARNING_RATE=0.001

# Early stopping based on pooled global validation loss
EARLY_STOPPING_ENABLED=1
EARLY_STOPPING_PATIENCE=5
EARLY_STOPPING_MIN_DELTA=0.001

# ------------------------------------------------------------------------------
# 4. Model Approval Gating (Experimental Safeguards)
# ------------------------------------------------------------------------------
MODEL_MIN_ACCURACY=0.80
MODEL_MIN_PNEUMONIA_RECALL=0.85
MODEL_MIN_PRECISION=0.70
MODEL_MAX_HOSPITAL_DETERIORATION=0.05
MODEL_MAX_VAL_LOSS_INCREASE=0.10

# ------------------------------------------------------------------------------
# 5. Quantization & Privacy Settings
# ------------------------------------------------------------------------------
# Set USE_QUANTIZATION=1 to enable INT8 quantization, or 0 to disable
USE_QUANTIZATION=1

# Smaller batches reduce GPU memory usage. 4 is the CUDA-safe default for
# 4 GB GPUs; increase only if nvidia-smi shows sufficient free memory.
BATCH_SIZE=4

# Set FORCE_CPU=1 to force CPU training, or 0 to automatically use GPU if available
FORCE_CPU=0

# Set USE_DP=1 to enable Differential Privacy via Opacus DP-SGD
USE_DP=0
DP_NOISE_MULTIPLIER=1.0
DP_MAX_GRAD_NORM=1.0
DP_DELTA=0.00001

# Logging verbosity: 0 for compact logs (recommended), 1 for detailed debugging
VERBOSE_LOGGING=0

# ------------------------------------------------------------------------------
# 6. Network Configuration
# ------------------------------------------------------------------------------
SERVER_ADDRESS=localhost:8080
FL_PORT=8080
FL_SERVER_BIND=0.0.0.0
